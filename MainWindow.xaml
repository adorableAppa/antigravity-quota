<Window x:Class="AntigravityQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:AntigravityQuota"
        Title="Antigravity Quota Dashboard" Height="850" Width="1280"
        MinHeight="700" MinWidth="1000"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Default"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="logo.png">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Theme Brushes (Default to Catppuccin Mocha) -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#11111b"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#313244"/>
        <SolidColorBrush x:Key="HeaderButtonBgBrush" Color="#181825"/>
        <SolidColorBrush x:Key="AccountCapsuleBgBrush" Color="#181825"/>
        <SolidColorBrush x:Key="AccountCapsuleBorderBrush" Color="#313244"/>
        <SolidColorBrush x:Key="TextTitleBrush" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="TextSubtitleBrush" Color="#A6ADC8"/>
        <SolidColorBrush x:Key="ModalBgBrush" Color="#c011111b"/>
        <SolidColorBrush x:Key="AccountItemBgBrush" Color="#313244"/>
        <SolidColorBrush x:Key="AccountItemBorderBrush" Color="#313244"/>

        <!-- Progress and Accent Brushes -->
        <SolidColorBrush x:Key="ProgressGradientStartBrush" Color="#CBA6F7"/>
        <SolidColorBrush x:Key="ProgressGradientEndBrush" Color="#89DCEB"/>
        <SolidColorBrush x:Key="ProgressExhaustedBrush" Color="#F38BA8"/>
        <SolidColorBrush x:Key="ProgressWarningBrush" Color="#FAB387"/>

        <!-- Accent Colors -->
        <Color x:Key="ProgressGradientStartColor">#CBA6F7</Color>
        <Color x:Key="ProgressGradientEndColor">#89DCEB</Color>
        <Color x:Key="ProgressGreenColor">#A6E3A1</Color>

        <!-- Glassmorphism Card Style -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource HeaderButtonBgBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ambient Glowing Backgrounds -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="500" Height="500" Canvas.Left="-150" Canvas.Top="-150" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8b5cf6" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="600" Height="600" Canvas.Right="-200" Canvas.Bottom="-200" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06b6d4" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Window Contents -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Update Banner -->
                <RowDefinition Height="*"/>    <!-- Content Body -->
            </Grid.RowDefinitions>

            <!-- 1. Header / Navigation Row -->
            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Placeholder -->
                        <Path Data="M12,2L2,12H5V21H19V12H22L12,2ZM7,14L12,9L17,14H7Z" Fill="{DynamicResource ProgressGradientStartBrush}" Width="32" Height="32" Stretch="Uniform" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Antigravity Quota" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}"/>
                            <TextBlock Text="Model Quota Hub" FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Toolbar Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Autocomplete models toggle -->
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="SHOW AUTOCOMPLETE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch x:Name="AutocompleteToggle" IsOn="False" Toggled="OnConfigChanged" OffContent="" OnContent="" Height="32" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Settings Button -->
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,8,16,0" Click="OnSettingsButtonClicked" ToolTip="Settings">
                            <ui:SymbolIcon Symbol="Setting" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                        </Button>

                        <!-- Sync Button -->
                        <Button x:Name="SyncButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,8,16,0" Click="OnSyncButtonClicked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sync" Margin="0,0,8,0"/>
                                <TextBlock Text="Sync"/>
                            </StackPanel>
                        </Button>

                        <!-- Account Capsule -->
                        <Border Background="{DynamicResource AccountCapsuleBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource AccountCapsuleBorderBrush}" BorderThickness="1" Height="38" Padding="12,0" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonDown="OnManageAccountsBorderClicked" ToolTip="Manage Google Accounts">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource ProgressGradientEndBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ActiveEmailText" Text="Not Logged In" Foreground="{DynamicResource TextTitleBrush}" VerticalAlignment="Center" FontWeight="Medium" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0,0,0" Width="20" Height="20" Click="OnManageAccountsClicked" Focusable="False">
                                    <ui:SymbolIcon Symbol="People" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Update Notification Banner -->
            <Border x:Name="UpdateBanner" Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,24" Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2c1a04" Offset="0"/>
                        <GradientStop Color="#1a1230" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#fe8019" Offset="0"/>
                        <GradientStop Color="#cba6f7" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Info Icon / Glowing Accent -->
                    <Border Grid.Column="0" Background="#30fe8019" CornerRadius="8" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Download" Foreground="#fe8019" Width="20" Height="20"/>
                    </Border>

                    <!-- Text / Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitleText" Text="Update Available!" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}"/>
                        <TextBlock x:Name="UpdateDescriptionText" Text="A new version is available on GitHub." FontSize="13" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="DownloadUpdateButton" Style="{StaticResource HeaderButtonStyle}" Background="#30fe8019" BorderBrush="#fe8019" Foreground="#fe8019" Content="Download Update (GitHub)" Click="OnDownloadUpdateClicked" Margin="0,0,8,0" Padding="16,6" Height="36"/>
                        <Button x:Name="DismissUpdateButton" Style="{StaticResource HeaderButtonStyle}" Content="Later" Click="OnDismissUpdateClicked" Padding="16,6" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Scrollable Dashboard Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Overview Panels -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.5*"/>
                            <ColumnDefinition Width="2.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Prompt Credits Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Prompt Credits" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource HeaderButtonBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="MONTHLY POOL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ProgressGradientStartBrush}"/>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Radial GDI+ Progress Custom Control -->
                                    <local:RadialProgress x:Name="CreditsRadial" Width="120" Height="120" Margin="0,0,32,0"/>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock x:Name="CreditsAvailableText" Text="0" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ProgressGradientEndBrush}" Margin="0,2,0,12"/>
                                        
                                        <TextBlock Text="TOTAL MONTHLY LIMIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock x:Name="CreditsMonthlyText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextTitleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sync Status Details Card -->
                        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Sync Status" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="StatusBadge" Background="#162e24" BorderBrush="#205c43" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="StatusBadgeText" Text="Standby" FontSize="9" FontWeight="Bold" Foreground="#34d399"/>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Last Checked:" Foreground="{DynamicResource TextSubtitleBrush}" FontSize="13"/>
                                        <TextBlock x:Name="LastCheckedText" Text="Never" Foreground="{DynamicResource TextTitleBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Active Plan Type:" Foreground="{DynamicResource TextSubtitleBrush}" FontSize="13"/>
                                        <TextBlock x:Name="PlanTypeText" Text="None" Foreground="{DynamicResource TextTitleBrush}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Antigravity Service:" Foreground="{DynamicResource TextSubtitleBrush}" FontSize="13"/>
                                        <TextBlock x:Name="ServiceStatusText" Text="Disconnected" Foreground="#f87171" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Models Quota Section -->
                    <StackPanel Grid.Row="1">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="AI Model Limits" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ModelCountText" Text="0 models tracked" FontSize="13" Foreground="{DynamicResource TextSubtitleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontWeight="Medium"/>
                        </DockPanel>

                        <!-- Models Loading State / List -->
                        <Grid>
                            <!-- Empty View -->
                            <Border x:Name="EmptyStateCard" Style="{StaticResource GlassCardStyle}" Padding="48" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="OutlineStar" Height="48" Width="48" Margin="0,0,0,16" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                    <TextBlock Text="No Quota Data Found" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Login to Google or verify that the Antigravity LSP Service is running locally in your IDE." Foreground="{DynamicResource TextSubtitleBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Models Grid (Loaded) -->
                            <ItemsControl x:Name="ModelsGridControl" Visibility="Visible">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCardStyle}" Margin="8" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ModelId}" FontSize="10" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Optional Autocomplete Badge -->
                                                    <Border Visibility="{Binding IsAutocompleteOnly, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource HeaderButtonBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <TextBlock Text="AUTOCOMPLETE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource ProgressGradientStartBrush}"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Card Progress -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                                    <DockPanel Margin="0,0,0,8">
                                                         <TextBlock Text="{Binding DisplayPercentage}" FontSize="13" FontWeight="SemiBold">
                                                             <TextBlock.Style>
                                                                 <Style TargetType="TextBlock">
                                                                     <Setter Property="Foreground" Value="{DynamicResource TextTitleBrush}"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Model.IsExhausted}" Value="True">
                                                                             <Setter Property="Foreground" Value="#f87171"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </TextBlock.Style>
                                                         </TextBlock>
                                                         <TextBlock Text="SESSION LIMIT" FontSize="9" Foreground="{DynamicResource TextSubtitleBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontWeight="Bold"/>
                                                    </DockPanel>
                                                    <!-- Progress Bar -->
                                                    <ProgressBar Value="{Binding ProgressBarValue, Mode=OneWay}" Height="6" Maximum="100" Foreground="{Binding ProgressBrush}" Background="#15ffffff" BorderThickness="0"/>
                                                </StackPanel>

                                                <!-- Card Footer -->
                                                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AccountItemBorderBrush}" Padding="0,12,0,0">
                                                    <DockPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Clock" Foreground="{Binding TimerColorBrush}" Margin="0,0,6,0" Width="14" Height="14"/>
                                                            <TextBlock Text="{Binding DisplayTimeLeft}" Foreground="{Binding TimerColorBrush}" FontSize="12" FontWeight="Medium"/>
                                                        </StackPanel>
                                                        
                                                        <Border Background="{DynamicResource HeaderButtonBgBrush}" CornerRadius="4" Padding="4" HorizontalAlignment="Right" Width="20" Height="20">
                                                            <!-- Sync Mode Indicator -->
                                                            <Path Data="{Binding MethodIconPath}" Fill="{Binding ProgressBrush}" Stretch="Uniform"/>
                                                        </Border>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>



        <!-- 4. Settings Dialog Overlay (Flyout / Modal) -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed" Background="{DynamicResource ModalBgBrush}">
            <Border Style="{StaticResource GlassCardStyle}" Width="650" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar (Navigation) -->
                    <Border Grid.Column="0" Background="{DynamicResource HeaderButtonBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" CornerRadius="16,0,0,16">
                        <Grid Margin="12,24,12,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" Margin="8,0,0,24"/>

                            <StackPanel Grid.Row="1">
                                <!-- General Tab Button -->
                                <Button x:Name="GeneralTabBtn" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,8" Click="OnGeneralTabClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Setting" Margin="0,0,8,0" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock Text="General" Foreground="{DynamicResource TextTitleBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Appearance Tab Button -->
                                <Button x:Name="AppearanceTabBtn" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,8" Click="OnAppearanceTabClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FontColor" Margin="0,0,8,0" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock Text="Appearance" Foreground="{DynamicResource TextTitleBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Accounts Tab Button -->
                                <Button x:Name="AccountsTabBtn" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,8" Click="OnAccountsTabClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ContactInfo" Margin="0,0,8,0" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock Text="Accounts" Foreground="{DynamicResource TextTitleBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- About Tab Button -->
                                <Button x:Name="AboutTabBtn" Style="{StaticResource HeaderButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8" Click="OnAboutTabClicked">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Help" Margin="0,0,8,0" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                        <TextBlock Text="About" Foreground="{DynamicResource TextTitleBrush}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right Content Area -->
                    <Grid Grid.Column="1" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Close Button (Shared) -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock x:Name="SettingsTabTitleText" Text="Appearance" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" VerticalAlignment="Center"/>
                            <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Padding="4" Click="OnCloseSettingsModalClicked">
                                <ui:SymbolIcon Symbol="Cancel" Foreground="{DynamicResource TextSubtitleBrush}"/>
                            </Button>
                        </DockPanel>

                        <!-- Tab Content Grid -->
                        <Grid Grid.Row="1">
                            <!-- General Tab View -->
                            <Grid x:Name="GeneralSettingsView" Visibility="Visible">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="System Behavior" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="4,0,0,8"/>
                                        <StackPanel Margin="4,0,4,16">
                                            <ui:ToggleSwitch x:Name="MinimizeToTrayToggle" Header="Minimize to System Tray" OffContent="Off" OnContent="On" Toggled="OnTraySettingsChanged" Margin="0,0,0,12"/>
                                            <ui:ToggleSwitch x:Name="CloseToTrayToggle" Header="Close to System Tray" OffContent="Off" OnContent="On" Toggled="OnTraySettingsChanged" Margin="0,0,0,12"/>
                                            <ui:ToggleSwitch x:Name="StartWithWindowsToggle" Header="Start with Windows (Autostart)" OffContent="Off" OnContent="On" Toggled="OnStartWithWindowsChanged"/>
                                        </StackPanel>

                                        <TextBlock Text="Sync Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="4,16,0,8"/>
                                        <StackPanel Margin="4,0,4,16">
                                            <TextBlock Text="Quota Sync Interval" FontSize="13" Foreground="{DynamicResource TextTitleBrush}" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="SyncIntervalComboBox" Width="200" HorizontalAlignment="Left" SelectionChanged="OnSyncIntervalChanged">
                                                <ComboBoxItem Content="Manual Refresh Only" Tag="0"/>
                                                <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
                                                <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                                                <ComboBoxItem Content="Every hour" Tag="60"/>
                                                <ComboBoxItem Content="Every 2 hours" Tag="120"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <TextBlock Text="Notifications" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="4,16,0,8"/>
                                        <StackPanel Margin="4,0,4,16">
                                            <ui:ToggleSwitch x:Name="NotificationsToggle" Header="Quota Change Notifications" OffContent="Off" OnContent="On" Toggled="OnNotificationsToggleChanged"/>
                                            <TextBlock Text="Get notified when a model quota is exhausted or resets." FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Appearance Tab View -->
                            <Grid x:Name="AppearanceSettingsView" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="Theme Flavor" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="4,0,0,8"/>
                                        <UniformGrid Columns="2">
                                        <!-- Catppuchin Mocha Card -->
                                        <Border x:Name="MochaCard" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Margin="4" Padding="12,10" Cursor="Hand" MouseLeftButtonDown="OnThemeCardClicked" Tag="Catppuchin Mocha" Background="#1E1E2E" Height="75">
                                            <Grid>
                                                <TextBlock Text="Catppuchin Mocha" FontSize="12.5" FontWeight="Bold" Foreground="#CDD6F4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Ellipse Width="8" Height="8" Fill="#CBA6F7" Margin="0,0,4,0"/>
                                                    <Ellipse Width="8" Height="8" Fill="#89DCEB" Margin="0,0,4,0"/>
                                                    <Ellipse Width="8" Height="8" Fill="#A6E3A1" Margin="0,0,4,0"/>
                                                    <Ellipse Width="8" Height="8" Fill="#F38BA8"/>
                                                </StackPanel>
                                            </Grid>
