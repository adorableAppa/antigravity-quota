                            <!-- Accounts Tab View -->
                            <Grid x:Name="AccountsSettingsView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Accounts List -->
                                <ScrollViewer Grid.Row="0" Margin="0,0,0,16">
                                    <ItemsControl x:Name="AccountsListControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AccountItemBgBrush}" BorderBrush="{DynamicResource AccountItemBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <!-- Active Badge -->
                                                            <Border Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#162e24" BorderBrush="#205c43" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                                <TextBlock Text="Active" FontSize="8" FontWeight="Bold" Foreground="#34d399"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                             <!-- Switch Account Button -->
                                                             <Button Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource DefaultButtonStyle}" Padding="10,4" Click="OnSwitchAccountClicked" Tag="{Binding Email}" ToolTip="Switch to this Account" FontSize="11" Height="28">
                                                                 <TextBlock Text="Switch" Foreground="{DynamicResource TextSubtitleBrush}" FontWeight="SemiBold"/>
                                                             </Button>
                                                            <!-- Remove Account Button -->
                                                            <Button Background="Transparent" BorderThickness="0" Padding="4" Margin="8,0,0,0" Click="OnRemoveAccountClicked" Tag="{Binding Email}" ToolTip="Log out">
                                                                <ui:SymbolIcon Symbol="Delete" Foreground="#f87171"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Modal Actions -->
                                <Button Grid.Row="1" Style="{StaticResource HeaderButtonStyle}" Background="#8b5cf6" Foreground="White" HorizontalAlignment="Stretch" Content="Add Google Account" Click="OnOAuthConnectClicked" FontWeight="Bold"/>
                            </Grid>

                            <!-- About Tab View -->
                            <Grid x:Name="AboutSettingsView" Visibility="Collapsed">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,8,0">
                                        <!-- Logo & App Title -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Path Data="M12,2L2,12H5V21H19V12H22L12,2ZM7,14L12,9L17,14H7Z" Fill="{DynamicResource ProgressGradientStartBrush}" Width="40" Height="40" Stretch="Uniform" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Antigravity Quota" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}"/>
                                                <TextBlock x:Name="AppVersionText" Text="v1.3.0" FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}"/>

                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Project description -->
                                        <TextBlock Text="About this project" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="A native Windows desktop dashboard for monitoring your AI model quotas, prompt credits, and usage limits in real-time. Built with native C# and WPF to stay self-contained, lightweight, and blazing fast." 
                                                   TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,0,0,20" LineHeight="18"/>

                                        <!-- Info/Link Cards -->
                                        <TextBlock Text="Developer &amp; Links" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" Margin="0,0,0,8"/>
                                        
                                        <!-- Developer Info -->
                                        <Border Background="{DynamicResource AccountItemBgBrush}" BorderBrush="{DynamicResource AccountItemBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Created by" FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                                    <TextBlock Text="Eric (ephf)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource DefaultButtonStyle}" Content="Visit Website" Click="OnVisitWebsiteClicked" Padding="12,6"/>
                                            </Grid>
                                        </Border>

                                        <!-- Github Repo -->
                                        <Border Background="{DynamicResource AccountItemBgBrush}" BorderBrush="{DynamicResource AccountItemBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Open Source" FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                                    <TextBlock Text="GitHub Repository" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextTitleBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource DefaultButtonStyle}" Content="View Repository" Click="OnViewRepositoryClicked" Padding="12,6"/>
                                            </Grid>
                                        </Border>

                                        <!-- Tech Stack summary -->
                                        <TextBlock Text="Tech Stack" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSubtitleBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="C# 12 • .NET 8.0 • WPF • ModernWPF • GDI+ P/Invoke" FontSize="11" Foreground="{DynamicResource TextSubtitleBrush}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
