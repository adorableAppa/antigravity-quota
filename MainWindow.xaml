<Window x:Class="AntigravityQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:local="clr-namespace:AntigravityQuota"
        Title="Antigravity Quota Dashboard" Height="850" Width="1280"
        MinHeight="700" MinWidth="1000"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Dark"
        Background="#0b0914"
        WindowStartupLocation="CenterScreen"
        Icon="logo.png">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <!-- Glassmorphism Card Style -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#131024"/>
            <Setter Property="BorderBrush" Value="#25213b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="ui:ControlHelper.CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#25213b"/>
            <Setter Property="Background" Value="#1a1633"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ambient Glowing Backgrounds -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="500" Height="500" Canvas.Left="-150" Canvas.Top="-150" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8b5cf6" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="600" Height="600" Canvas.Right="-200" Canvas.Bottom="-200" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06b6d4" Offset="0" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Main Window Contents -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header / Navigation Row -->
            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Placeholder -->
                        <Path Data="M12,2L2,12H5V21H19V12H22L12,2ZM7,14L12,9L17,14H7Z" Fill="#8b5cf6" Width="32" Height="32" Stretch="Uniform" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Antigravity Quota" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Model Quota Hub" FontSize="11" Foreground="#8e8e93" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Toolbar Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Autocomplete models toggle -->
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="SHOW AUTOCOMPLETE" FontSize="9" FontWeight="Bold" Foreground="#8e8e93" Margin="0,0,0,4"/>
                            <ui:ToggleSwitch x:Name="AutocompleteToggle" IsOn="False" Toggled="OnConfigChanged" OffContent="" OnContent="" Height="32" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sync Button -->
                        <Button x:Name="SyncButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,8,16,0" Click="OnSyncButtonClicked">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sync" Margin="0,0,8,0"/>
                                <TextBlock Text="Sync"/>
                            </StackPanel>
                        </Button>

                        <!-- Account Capsule -->
                        <Border Background="#1f1a3a" CornerRadius="8" BorderBrush="#352e5c" BorderThickness="1" Height="38" Padding="12,0" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonDown="OnManageAccountsBorderClicked" ToolTip="Manage Google Accounts">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#06b6d4" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ActiveEmailText" Text="Not Logged In" Foreground="White" VerticalAlignment="Center" FontWeight="Medium" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0,0,0" Width="20" Height="20" Click="OnManageAccountsClicked" Focusable="False">
                                    <ui:SymbolIcon Symbol="People" Foreground="#8e8e93"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Scrollable Dashboard Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Overview Panels -->
                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3.5*"/>
                            <ColumnDefinition Width="2.5*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Prompt Credits Card -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Prompt Credits" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border Background="#21153d" BorderBrush="#3b2075" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="MONTHLY POOL" FontSize="9" FontWeight="Bold" Foreground="#a78bfa"/>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Radial GDI+ Progress Custom Control -->
                                    <local:RadialProgress x:Name="CreditsRadial" Width="120" Height="120" Margin="0,0,32,0"/>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="#8e8e93"/>
                                        <TextBlock x:Name="CreditsAvailableText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#06b6d4" Margin="0,2,0,12"/>
                                        
                                        <TextBlock Text="TOTAL MONTHLY LIMIT" FontSize="10" FontWeight="Bold" Foreground="#8e8e93"/>
                                        <TextBlock x:Name="CreditsMonthlyText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sync Status Details Card -->
                        <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Sync Status" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <Border x:Name="StatusBadge" Background="#162e24" BorderBrush="#205c43" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="StatusBadgeText" Text="Standby" FontSize="9" FontWeight="Bold" Foreground="#34d399"/>
                                    </Border>
                                </DockPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,12">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Last Checked:" Foreground="#8e8e93" FontSize="13"/>
                                        <TextBlock x:Name="LastCheckedText" Text="Never" Foreground="White" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Active Plan Type:" Foreground="#8e8e93" FontSize="13"/>
                                        <TextBlock x:Name="PlanTypeText" Text="None" Foreground="White" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock Text="Antigravity Service:" Foreground="#8e8e93" FontSize="13"/>
                                        <TextBlock x:Name="ServiceStatusText" Text="Disconnected" Foreground="#f87171" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ManageAccountsButton" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,8,0" Click="OnManageAccountsClicked" ToolTip="Manage Google Accounts" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="People" Margin="0,0,8,0"/>
                                            <TextBlock Text="Accounts"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OAuthConnectButton" Style="{StaticResource HeaderButtonStyle}" Click="OnOAuthConnectClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Google Icon Path -->
                                            <Path Data="M12.24,10.285V14.4h6.887c-.648,2.41-2.519,4.114-5.136,4.114a6.273,6.273,0,1,1,.003-12.545c1.677,0,3.128.654,4.253,1.72l3.242-3.244C19.16,2.378,16.002,1,12.24,1,6.033,1,1,6.033,1,12.24s5.033,11.24,11.24,11.24c6.478,0,11.24-4.551,11.24-11.24,0-.763-.085-1.5-.24-2.185H12.24z" Fill="White" Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform"/>
                                            <TextBlock Text="Connect Google Account"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Models Quota Section -->
                    <StackPanel Grid.Row="1">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="AI Model Limits" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ModelCountText" Text="0 models tracked" FontSize="13" Foreground="#8e8e93" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontWeight="Medium"/>
                        </DockPanel>

                        <!-- Models Loading State / List -->
                        <Grid>
                            <!-- Empty View -->
                            <Border x:Name="EmptyStateCard" Style="{StaticResource GlassCardStyle}" Padding="48" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="OutlineStar" Height="48" Width="48" Margin="0,0,0,16" Foreground="#8e8e93"/>
                                    <TextBlock Text="No Quota Data Found" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Login to Google or verify that the Antigravity LSP Service is running locally in your IDE." Foreground="#8e8e93" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="320"/>
                                </StackPanel>
                            </Border>

                            <!-- Models Grid (Loaded) -->
                            <ItemsControl x:Name="ModelsGridControl" Visibility="Visible">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" IsItemsHost="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCardStyle}" Margin="8" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding ModelId}" FontSize="10" Foreground="#8e8e93" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Optional Autocomplete Badge -->
                                                    <Border Visibility="{Binding IsAutocompleteOnly, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#21202e" BorderBrush="#3f3b5c" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <TextBlock Text="AUTOCOMPLETE" FontSize="8" FontWeight="Bold" Foreground="#a78bfa"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Card Progress -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding DisplayPercentage}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding TextColorBrush}"/>
                                                        <TextBlock Text="SESSION LIMIT" FontSize="9" Foreground="#8e8e93" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontWeight="Bold"/>
                                                    </DockPanel>
                                                    <!-- Progress Bar -->
                                                    <ProgressBar Value="{Binding ProgressBarValue, Mode=OneWay}" Height="6" Maximum="100" Foreground="{Binding ProgressBrush}" Background="#15ffffff" BorderThickness="0"/>
                                                </StackPanel>

                                                <!-- Card Footer -->
                                                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#15ffffff" Padding="0,12,0,0">
                                                    <DockPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Clock" Foreground="{Binding TimerColorBrush}" Margin="0,0,6,0" Width="14" Height="14"/>
                                                            <TextBlock Text="{Binding DisplayTimeLeft}" Foreground="{Binding TimerColorBrush}" FontSize="12" FontWeight="Medium"/>
                                                        </StackPanel>
                                                        
                                                        <Border Background="#1a1c38" CornerRadius="4" Padding="4" HorizontalAlignment="Right" Width="20" Height="20">
                                                            <!-- Sync Mode Indicator -->
                                                            <Path Data="{Binding MethodIconPath}" Fill="{Binding ProgressBrush}" Stretch="Uniform"/>
                                                        </Border>
                                                    </DockPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 3. Accounts Management Dialog Overlay (Flyout / Modal) -->
        <Grid x:Name="AccountsModal" Visibility="Collapsed" Background="#c0040308">
            <Border Style="{StaticResource GlassCardStyle}" Width="450" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="Manage Google Accounts" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Padding="4" Click="OnCloseAccountsModalClicked">
                            <ui:SymbolIcon Symbol="Cancel" Foreground="#8e8e93"/>
                        </Button>
                    </DockPanel>

                    <!-- Accounts List -->
                    <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
                        <ItemsControl x:Name="AccountsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#19ffffff" BorderBrush="#15ffffff" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Email}" FontSize="13" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <!-- Active Badge -->
                                                <Border Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#162e24" BorderBrush="#205c43" BorderThickness="1" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock Text="Active" FontSize="8" FontWeight="Bold" Foreground="#34d399"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <!-- Switch Account Button -->
                                                 <Button Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Style="{StaticResource DefaultButtonStyle}" Padding="10,4" Click="OnSwitchAccountClicked" Tag="{Binding Email}" ToolTip="Switch to this Account" FontSize="11" Height="28">
                                                     <TextBlock Text="Switch" Foreground="#8e8e93" FontWeight="SemiBold"/>
                                                 </Button>
                                                <!-- Remove Account Button -->
                                                <Button Background="Transparent" BorderThickness="0" Padding="4" Margin="8,0,0,0" Click="OnRemoveAccountClicked" Tag="{Binding Email}" ToolTip="Log out">
                                                    <ui:SymbolIcon Symbol="Delete" Foreground="#f87171"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Modal Actions -->
                    <Button Grid.Row="2" Style="{StaticResource HeaderButtonStyle}" Background="#8b5cf6" Foreground="White" HorizontalAlignment="Stretch" Content="Add Google Account" Click="OnOAuthConnectClicked" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
